rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /identities/{identityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && (request.resource == null // delete
              || (request.resource.data.name is string && request.resource.data.name.size() > 0));
      }

      match /habits/{habitId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && (request.resource == null // delete
              || (request.resource.data.title is string && request.resource.data.title.size() > 0
                  && request.resource.data.identityId is string));
      }

      match /badHabits/{badHabitId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && (request.resource == null // delete
              || (request.resource.data.name is string && request.resource.data.name.size() > 0
                  && request.resource.data.identityId is string));
      }

      match /completions/{completionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && (request.resource == null // delete
              || (request.resource.data.habitId is string && request.resource.data.identityId is string));
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
